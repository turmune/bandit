# Copy to .env (which is gitignored) and fill in.
#
# Used by:
#   ./bandit            the client, to reach your deployed API
#   docker compose up   locally, to set the server's required API key

BANDIT_URL=https://bandit.efobay.com
BANDIT_API_KEY=

# Note: no :8000 on BANDIT_URL. That suffix belongs only in Coolify's domain
# field, where it selects the container port. It is not part of the public URL.
