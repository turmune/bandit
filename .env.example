# Copy to .env (which is gitignored) and fill in.
#
# Used by:
#   ./bandit            the client, to reach your deployed API
#   docker compose up   locally, to set the server's required API key

BANDIT_URL=https://<host>.<tailnet>.ts.net
BANDIT_API_KEY=

# BANDIT_URL is required -- there is no default host. Get the exact value from
# the machine running the API with `tailscale serve status`; it is the line
# ending in .ts.net, and only machines on your tailnet can reach it.
#
# Note: no :8000 on BANDIT_URL. `tailscale serve` fronts the container on 443,
# and the :8000 suffix belongs only in a Coolify domain field, where it selects
# the container port. It is not part of the URL callers use.
